# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required ---
GROQ_API_KEY=
TAVILY_API_KEY=
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side secret key (sb_secret_...). Backend only, never in frontend code.
SUPABASE_KEY=
# Public key used by the browser for Supabase Auth (sb_publishable_...).
SUPABASE_PUBLISHABLE_KEY=
OCR_SPACE_API_KEY=

# --- Admin ---
# Comma-separated admin emails. The account must also have
# app_metadata.role = "admin" (run: python -m scripts.grant_admin).
# Admins sign in with their normal Supabase account; no admin password
# is stored or checked by this application.
ADMIN_EMAIL=

# --- Optional ---
# APP_ENV=production disables /docs and /openapi.json.
APP_ENV=development
APP_VERSION=1.2.0
# Extra browser origins allowed to call the API (comma-separated).
# Not needed when the frontend is served by this app.
ALLOWED_ORIGINS=
MAX_PDF_MB=25
MAX_IMAGE_MB=10
MAX_AUDIO_MB=25
