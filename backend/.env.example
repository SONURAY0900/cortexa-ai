# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required ---
GROQ_API_KEY=
TAVILY_API_KEY=
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side secret key (sb_secret_...). Backend only, never in frontend code.
SUPABASE_KEY=
# Public key used by the browser for Supabase Auth (sb_publishable_...).
SUPABASE_PUBLISHABLE_KEY=
OCR_SPACE_API_KEY=

# --- Admin ---
# Comma-separated allowlist of admin emails (not a secret). An account is
# an admin only if its email is listed here AND its public.profiles.role
# is 'ADMIN' (set in the Supabase Dashboard or with
# `python -m scripts.grant_admin --grant`). Admins sign in on the normal
# login page; no admin password is stored or checked by this application.
ADMIN_EMAIL=

# --- Optional ---
# APP_ENV=production disables /docs and /openapi.json.
APP_ENV=development
APP_VERSION=1.2.0
# Extra browser origins allowed to call the API (comma-separated).
# Not needed when the frontend is served by this app.
ALLOWED_ORIGINS=
MAX_PDF_MB=25
MAX_IMAGE_MB=10
MAX_AUDIO_MB=25
# Large PDFs: page cap, scanned pages sent to OCR per PDF (0 = no cap),
# and PDFs indexed at the same time (others wait their turn).
MAX_PDF_PAGES=300
MAX_OCR_PAGES=50
PDF_MAX_CONCURRENT=1
# Signed-in users: actions per rolling hour per account (0 = no limit).
CHAT_MESSAGES_PER_HOUR=60
PDF_UPLOADS_PER_HOUR=10
IMAGE_UPLOADS_PER_HOUR=20
VOICE_REQUESTS_PER_HOUR=30
# Groq per-request timeout (seconds) and retries.
# GROQ_TIMEOUT_S=60
# GROQ_MAX_RETRIES=2

# --- Email code sign-in (display only; defaults shown) ---
# Supabase Auth enforces code expiry: set "Email OTP expiration" to 600
# in the Supabase Dashboard. Keep these equal to that setting and to
# Supabase's 60-second resend interval; they only drive the countdowns.
# EMAIL_OTP_EXPIRY_S=600
# EMAIL_OTP_RESEND_S=60

# --- Welcome email (optional; disabled when unset) ---
# Provider: smtp | resend | brevo. Render's free instances block outbound
# SMTP ports, so use resend or brevo (HTTPS) there.
WELCOME_EMAIL_PROVIDER=
# Sender, e.g. Cortexa AI <no-reply@your-domain.com> (must be a sender
# your provider has verified).
EMAIL_FROM=
# Public app URL used for the "Start chatting" link.
APP_PUBLIC_URL=
# Optional support contact; leave empty to omit it from the email.
SUPPORT_EMAIL=
SUPPORT_URL=
# smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# resend / brevo (server-side only)
RESEND_API_KEY=
BREVO_API_KEY=

# --- OCR (optional; defaults shown) ---
# OCR.space engines: primary first, fallback on errors or poor text.
# OCR_SPACE_ENGINE=2
# OCR_SPACE_FALLBACK_ENGINE=3
# OCR_SPACE_LANGUAGE=auto
# Total attempts per page (alternating engines), with exponential backoff.
# OCR_MAX_ATTEMPTS=4
# OCR_RETRY_BASE_DELAY_S=1.0
# OCR_RETRY_MAX_DELAY_S=8.0
# OCR_CONNECT_TIMEOUT_S=10
# OCR_READ_TIMEOUT_S=90
# Minimum spacing between OCR.space requests (rate limits).
# OCR_SPACE_MIN_INTERVAL_S=0.5
# OCR_RENDER_DPI=150
# OCR_SPACE_MAX_UPLOAD_BYTES=1000000
