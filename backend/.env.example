# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required ---
GROQ_API_KEY=
TAVILY_API_KEY=
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side secret key (sb_secret_...). Backend only, never in frontend code.
SUPABASE_KEY=
# Public key used by the browser for Supabase Auth (sb_publishable_...).
SUPABASE_PUBLISHABLE_KEY=
OCR_SPACE_API_KEY=

# --- Admin ---
# Comma-separated allowlist of admin emails (not a secret). An account is
# an admin only if its email is listed here AND its public.profiles.role
# is 'ADMIN' (set in the Supabase Dashboard or with
# `python -m scripts.grant_admin --grant`). Admins sign in on the normal
# login page; no admin password is stored or checked by this application.
ADMIN_EMAIL=

# --- Optional ---
# APP_ENV=production disables /docs and /openapi.json.
APP_ENV=development
APP_VERSION=1.2.0
# Extra browser origins allowed to call the API (comma-separated).
# Not needed when the frontend is served by this app.
ALLOWED_ORIGINS=
MAX_PDF_MB=25
MAX_IMAGE_MB=10
MAX_AUDIO_MB=25
# Groq per-request timeout (seconds) and retries.
# GROQ_TIMEOUT_S=60
# GROQ_MAX_RETRIES=2

# --- OCR (optional; defaults shown) ---
# OCR.space engines: primary first, fallback on errors or poor text.
# OCR_SPACE_ENGINE=2
# OCR_SPACE_FALLBACK_ENGINE=3
# OCR_SPACE_LANGUAGE=auto
# Total attempts per page (alternating engines), with exponential backoff.
# OCR_MAX_ATTEMPTS=4
# OCR_RETRY_BASE_DELAY_S=1.0
# OCR_RETRY_MAX_DELAY_S=8.0
# OCR_CONNECT_TIMEOUT_S=10
# OCR_READ_TIMEOUT_S=90
# Minimum spacing between OCR.space requests (rate limits).
# OCR_SPACE_MIN_INTERVAL_S=0.5
# OCR_RENDER_DPI=150
# OCR_SPACE_MAX_UPLOAD_BYTES=1000000
